# Allowlist: only the files listed below are tracked.
*
!*/
!.gitignore
!app.py
!app_service.py
!recommender.py
!requirements.txt
!requirements-dev.txt
!README.md
!.streamlit/config.toml
!expected_outputs.json
!tests/test_*.py

# Model artifacts (derived files only)
!artifacts/catalog.parquet
!artifacts/itemknn_sim.npz
!artifacts/als_item_factors.npy
!artifacts/popularity.json
!artifacts/model_params.json
!artifacts/expected_outputs.json

# Raw data and caches: never commit
data/
cache/
*.jsonl
*.jsonl.gz
*.csv
*.csv.gz
.venv/
__pycache__/
.pytest_cache/
.DS_Store

# Secrets: never commit
.streamlit/secrets.toml
.env
.env.*
*.pem
*.key
